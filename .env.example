# Copy the real values from the Neon dashboard (Connect -> ".env" snippet).
# Both strings must include the role AND password before the host, like:
#   postgresql://neondb_owner:npg_a1B2c3D4e5F6@ep-quiet-frost-a1b2c3d4-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full

# Pooled connection (host contains "-pooler"). Used by the running app.
DATABASE_URL="postgresql://ROLE:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full"

# Direct connection (same host without "-pooler"). Used by the Prisma CLI for
# `migrate` / `studio`. Optional: falls back to DATABASE_URL.
DIRECT_URL="postgresql://ROLE:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full"
